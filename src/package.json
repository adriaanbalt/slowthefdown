{
  "name": "slowthefdown",
  "version": "10.0.0",
  "description": "Meditative game",
  "author": "Adriaan Balt",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build": "eas build -p ios --profile development",
    "build:dev": "eas build -p ios --profile development-simulator",
    "deploy:preview": "eas build -p ios --profile preview",
    "deploy": "eas build -p ios --profile production",
    "submit": "eas submit -p ios --profile production --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-firebase/app": "^27.0.0",
    "@react-native-firebase/auth": "^27.0.0",
    "@react-native-firebase/database": "^27.0.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-gl": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-country-picker-modal": "^3.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
